<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" prefWidth="400" minWidth="300">
    <center>
        <VBox fx:id="mainBox" spacing="20" styleClass="autogram-prose">
            <TextFlow styleClass="autogram-heading-m">
                <Text styleClass="autogram-heading-l" text="%settings.restart.title"/>
            </TextFlow>

            <TextFlow styleClass="autogram-body">
                <Text styleClass="autogram-body" text="%settings.restart.text"/>
            </TextFlow>
        </VBox>
    </center>

    <bottom>
        <VBox spacing="10" styleClass="autogram-actions">
            <padding>
                <Insets left="30" bottom="20" />
            </padding>
            <HBox styleClass="autogram-actions" alignment="CENTER_LEFT">
                <HBox styleClass="autogram-actions">
                    <Button fx:id="restartButton" onAction="#onRestartButtonAction" text="%settings.restart.restart"
                            styleClass="autogram-button,autogram-button--primary"/>
                    <Button fx:id="closeButton" onAction="#onCloseButtonAction" text="%general.close.btn"
                            styleClass="autogram-button,autogram-button--secondary"/>
                </HBox>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
