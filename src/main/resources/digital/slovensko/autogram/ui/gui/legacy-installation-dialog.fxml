<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      prefWidth="500" minWidth="450"
      fx:id="mainBox">
    <VBox>
        <TextFlow fx:id="title" styleClass="autogram-heading-m">
            <Text styleClass="autogram-heading-m" text="%legacyInstallation.heading"/>
        </TextFlow>

        <VBox styleClass="autogram-prose">
            <TextFlow styleClass="autogram-body">
                <Text fx:id="text" styleClass="autogram-body"/>
            </TextFlow>
            <TextFlow>
                <Text fx:id="error" styleClass="autogram-error-message" managed="false" visible="false"/>
            </TextFlow>
        </VBox>
        <HBox styleClass="autogram-actions">
            <Button fx:id="mainButton" styleClass="autogram-button" text="%legacyInstallation.uninstall.btn" onAction="#onUninstallButtonPressed"/>
            <Button fx:id="cancelButton" styleClass="autogram-link" text="%legacyInstallation.cancel.btn" onAction="#onCancelButtonPressed"/>
        </HBox>
    </VBox>
</VBox>
