<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      prefWidth="500" minWidth="450"
      fx:id="mainBox">
    <VBox>
        <TextFlow fx:id="title" styleClass="autogram-heading-m">
            <Text styleClass="autogram-heading-m" text="%update.newVersion.title"/>
        </TextFlow>

        <VBox styleClass="autogram-prose">
            <TextFlow styleClass="autogram-body">
                <Text fx:id="text" styleClass="autogram-body" text="%update.newVersion.text"/>
            </TextFlow>
            <TextFlow fx:id="moreInfo" styleClass="autogram-body" managed="false" visible="false">
                <Hyperlink styleClass="autogram-link" text="%update.moreInfo.link" onAction="#downloadAction"/>
            </TextFlow>
        </VBox>
        <FlowPane styleClass="autogram-actions--wrapping">
            <Button fx:id="storeButton" styleClass="autogram-button" text="%update.store.btn" onAction="#storeAction"
                    managed="false" visible="false"/>
            <Button fx:id="mainButton" styleClass="autogram-button" text="%update.download.btn" onAction="#downloadAction"/>
            <Button fx:id="cancelButton" styleClass="autogram-link" text="%update.cancel.btn" onAction="#onCancelButtonPressed"/>
        </FlowPane>
    </VBox>
</VBox>
