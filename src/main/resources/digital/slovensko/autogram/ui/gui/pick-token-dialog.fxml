<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Polygon?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      prefWidth="550" minWidth="450"
      fx:id="mainBox">

    <VBox fx:id="formGroup" styleClass="autogram-form-group">
        <TextFlow>
            <Text fx:id="heading" styleClass="autogram-heading-l" VBox.vgrow="ALWAYS" text="%pickDriver.select.title"/>
        </TextFlow>

        <!-- what went wrong and how to fix it, as plain text - GOV.UK error messages are only for validation errors -->
        <VBox fx:id="noTokenFound" styleClass="autogram-problem">
            <TextFlow fx:id="noTokenFoundTitle">
                <Text styleClass="autogram-heading-m" text="%pickDriver.noToken.title"/>
            </TextFlow>
            <TextFlow>
                <Text styleClass="autogram-body" text="%pickDriver.noToken.text"/>
            </TextFlow>
            <VBox styleClass="autogram-list-bullet">
                <HBox>
                    <Text styleClass="autogram-body" text="•"/>
                    <TextFlow>
                        <Text styleClass="autogram-body" text="%pickDriver.noToken.inserted"/>
                    </TextFlow>
                </HBox>
                <HBox>
                    <Text styleClass="autogram-body" text="•"/>
                    <TextFlow>
                        <Text styleClass="autogram-body" text="%pickDriver.noToken.connected"/>
                    </TextFlow>
                </HBox>
                <HBox>
                    <Text styleClass="autogram-body" text="•"/>
                    <TextFlow>
                        <Text styleClass="autogram-body" text="%pickDriver.noToken.driver"/>
                    </TextFlow>
                </HBox>
            </VBox>
        </VBox>
        <VBox fx:id="notResponding" styleClass="autogram-problem">
            <TextFlow fx:id="notRespondingTitle">
                <Text styleClass="autogram-heading-m" text="%pickDriver.notResponding.title"/>
            </TextFlow>
            <TextFlow>
                <Text styleClass="autogram-body" text="%pickDriver.notResponding.text"/>
            </TextFlow>
        </VBox>

        <TextFlow>
            <Text fx:id="error" styleClass="autogram-error-message" managed="false" text="%pickDriver.error.title"/>
        </TextFlow>
        <ScrollPane fx:id="optionsScrollPane" styleClass="autogram-options-scroll-pane" fitToWidth="true" hbarPolicy="NEVER">
            <!-- one list of radios: cards found, drivers that can't tell, the keystore file option is always the last one -->
            <VBox styleClass="autogram-options">
                <VBox fx:id="radios" styleClass="autogram-radios"/>
                <VBox fx:id="otherDriverRadios" styleClass="autogram-radios"/>
                <VBox fx:id="driverRadios" styleClass="autogram-radios"/>
            </VBox>
        </ScrollPane>
    </VBox>

    <!-- like GOV.UK details, help only some users need -->
    <VBox fx:id="help">
        <Button fx:id="helpButton" styleClass="autogram-link,autogram-details-summary" text="%pickDriver.help.btn"
                onAction="#onHelpButtonAction">
            <graphic>
                <Polygon points="0.0, 0.0, 9.0, 6.0, 0.0, 12.0"/>
            </graphic>
        </Button>
        <VBox fx:id="helpText" styleClass="autogram-details__text" visible="false" managed="false">
            <TextFlow>
                <Text styleClass="autogram-body" text="%pickDriver.help.text"/>
            </TextFlow>
        </VBox>
    </VBox>

    <HBox styleClass="autogram-actions">
        <Button styleClass="autogram-button" fx:id="mainButton" text="%pickDriver.select.btn"
                onAction="#onPickButtonAction"/>
        <Button styleClass="autogram-button,autogram-button--secondary" fx:id="searchAgainButton"
                text="%pickDriver.searchAgain.btn" onAction="#onSearchAgainButtonAction"/>
    </HBox>

</VBox>
